    private async void LoadRecommendationTemplate()
    {
        var rcms = await _checkupApiClient.GetRecommendationTemplateListAsync();
        lstRecommendList.DataSource = rcms.RecommendationTemplates.ToList();
        lstRecommendList.DisplayMember = "Text";
        lstRecommendList.ValueMember = "Text";
    }

    private async void GetAudiogram()
    {
        var audiogram = _checkupViewModel.Audiograms.FirstOrDefault();
        if (audiogram == null)
            return;

        ddlEarsRight.EditValue = audiogram.RightAbnormalTypeId;
        txtEarsRightRemark.Text = audiogram.RightResult;
        txtEarsLeftRemark.Text = audiogram.LeftResult;
        ddlEarsLeft.EditValue = audiogram.LeftAbnormalTypeId;

        var hearingHertzs = await _checkupApiClient.GetHearingHertzListAsync(1, 20);
        var hearingHertzList = hearingHertzs.Items.ToList();
        var hearingListPage = await _checkupApiClient.GetHearingListByAudigramIdAsync(audiogram.Id, 1, 20);
        var hearingList = hearingListPage.Items.ToList();

        var hearing = from Hz in hearingHertzList
                      join Hr in hearingList on Hz.Hertz equals Hr.Hertz into resultJoin
                      from Rh in resultJoin.DefaultIfEmpty()
                      select new
                      {
                          Id = Rh?.Id,
                          Hertz = Hz.Hertz.ToString(),
                          RightHz = Rh?.RightHz.ToString(),
                          LeftHz = Rh?.LeftHz.ToString(),
                      };

        grdHearing.DataSource = hearing;
    }

    private async void GetPhysicalExamination()
    {
        PhysicalExaminationViewModel _checkupPE;

        try
        {
            _checkupPE = await _checkupApiClient.GetPhysicalExaminationByVisitNumberAsync(_checkupViewModel?.VisitNumber);
        }
        catch (Exception ex)
        {
            Debug.WriteLine(ex.Message);
            _checkupPE = null;
        }

        if (_checkupPE != null)
        {
            ddlGA_LevelOfConsciousne.EditValue = _checkupPE.Ga;
            ddlGA_Heen.EditValue = _checkupPE.Heent;
            ddlGA_MouthAndThroat.EditValue = _checkupPE.Mouth;
            ddlGA_Lymphoma.EditValue = _checkupPE.Lymph;
            ddlGA_Thyroid.EditValue = _checkupPE.Thyroid;
            ddlGA_LungChestBreast.EditValue = _checkupPE.Chest;
            ddlGA_Heart.EditValue = _checkupPE.Heart;
            ddlGA_Abdomen.EditValue = _checkupPE.Abdomen;
            ddlGA_Extremties.EditValue = _checkupPE.Ext;
            ddlGA_Skin.EditValue = _checkupPE.Skin;
            ddlGA_Others.EditValue = _checkupPE.Other;

            txtGA_LevelOfConsciousne.Text = _checkupPE.GaText;
            txtGA_Heen.Text = _checkupPE.HeentText;
            txtGA_MouthAndThroat.Text = _checkupPE.MouthText;
            txtGA_Lymphoma.Text = _checkupPE.LymphText;
            txtGA_Thyroid.Text = _checkupPE.ThyroidText;
            txtGA_LungChestBreast.Text = _checkupPE.ChestText;
            txtGA_Heart.Text = _checkupPE.HeartText;
            txtGA_Abdomen.Text = _checkupPE.AbdomenText;
            txtGA_Extremties.Text = _checkupPE.ExtText;
            txtGA_Skin.Text = _checkupPE.SkinText;
            txtGA_Others.Text = _checkupPE.OtherText;
        }
    }
     
    private async void GetEye()
    {
        _hosXpEyeLabViewmodel = await Fn.HosxpGetEYEByVisitNumberAsync(_checkupViewModel?.VisitNumber, this, _hosxpApiClient, false);
        if (_hosXpEyeLabViewmodel != null)
        {
            txtVS_VisibilityLeft.Text = _hosXpEyeLabViewmodel.VA_Left_Note;
            txtVS_VisibilityRight.Text = _hosXpEyeLabViewmodel.VA_Right_Note;
            txtPH_VisibilityLeft.Text = _hosXpEyeLabViewmodel.PH_Left_Note;
            txtPH_VisibilityRight.Text = _hosXpEyeLabViewmodel.PH_Right_Note;
            txtVS_EyeballLeft.Text = _hosXpEyeLabViewmodel.PressureLeft?.ToString();
            txtVS_EyeballRight.Text = _hosXpEyeLabViewmodel.PressureRight?.ToString();
            txtVS_RetinaLeft.Text = _hosXpEyeLabViewmodel.RetinaLeft?.ToString();
            txtVS_RetinaRight.Text = _hosXpEyeLabViewmodel.RetinaRight?.ToString();
            txtVS_BlindRemark.Text = _hosXpEyeLabViewmodel.ColorBlind;
            txtVS_3D.Text = _hosXpEyeLabViewmodel.Vision3D;
            txtVS_Squit.Text = _hosXpEyeLabViewmodel.Squint;
            txtVS_VisualField.Text = _hosXpEyeLabViewmodel.VisualField;

        }
    }

    private void GetOtherSpecial(List<Checkup.Api.Client.XrayViewModel> xrays)
    {
        //var xrays = await Fn.CheckupGetXrayList(_checkupViewModel?.VisitNumber, this, _checkupApiClient, false);
        if (xrays.Count > 0)
        {
            txtX_EKGResult.Text = xrays.FirstOrDefault(s => s.CheckupItem?.Code == CheckupItemCode.EKG)?.ResultReport;
            txtX_ESTRemark.Text = xrays.FirstOrDefault(s => s.CheckupItem?.Code == CheckupItemCode.EST)?.ResultReport;
            txtX_BMDRemark.Text = xrays.FirstOrDefault(s => s.CheckupItem?.Code == CheckupItemCode.BMD)?.ResultReport;
            txtX_ABIRemark.Text = xrays.FirstOrDefault(s => s.CheckupItem?.Code == CheckupItemCode.ABI)?.ResultReport;
            txtVegina.Text = xrays.FirstOrDefault(s => s.CheckupItem?.Code == CheckupItemCode.PapSmear)?.ResultReport;
            txtPapSmear.Text = xrays.FirstOrDefault(s => s.CheckupItem?.Code == CheckupItemCode.LiquidBasedPap)?.ResultReport;
        }
    }


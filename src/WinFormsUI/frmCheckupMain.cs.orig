    private async void SaveCheckupData()
    {
        await SavePhysicalExamAsync(_checkupViewModel);

        //await SaveVisionAsync(_checkupViewModel);
        var audiogram = _checkupViewModel.Audiograms.FirstOrDefault();
        if (audiogram == null)
        {
            CreateAudiogram();
        }
        else
        {

        }

        List<FinalLabCommand> finalLabCommands = [];
        //
        //Lab
        //
        List<LabXrayStruct> urines = (List<LabXrayStruct>)gridUrine.DataSource;
        List<LabXrayStruct> cbcs = (List<LabXrayStruct>)grdCBC.DataSource;
        List<LabXrayStruct> stools = (List<LabXrayStruct>)gridStool.DataSource;
        List<LabXrayStruct> stoolCultures = (List<LabXrayStruct>)gridStoolCulture.DataSource;
        List<LabXrayStruct> specialTests = (List<LabXrayStruct>)grdSpecialTest.DataSource;
        List<LabXrayStruct> confidentials = (List<LabXrayStruct>)grdConfidential.DataSource;
        List<LabXrayStruct> bloodChemistry = (List<LabXrayStruct>)gridBloodChemistry.DataSource;

        urines.ForEach(urine => finalLabCommands.Add(new FinalLabCommand()
        {
            ClassCode = CClass.UrineAnalysis,
            Interpretation = string.Empty,
            Name = urine.ResultItemName,
            ReferenceRange = urine.ReferenceRange,
            ResultValue = urine.ResultValue,

        }));

        cbcs.ForEach(cbc => finalLabCommands.Add(new FinalLabCommand()
        {
            ClassCode = CClass.CBC,
            Interpretation = string.Empty,
            Name = cbc.ResultItemName,
            ReferenceRange = cbc.ReferenceRange,
            ResultValue = cbc.ResultValue,
        }));

        stools.ForEach(stool => finalLabCommands.Add(new FinalLabCommand()
        {
            ClassCode = CClass.StoolExamination,
            Interpretation = string.Empty,
            Name = stool.ResultItemName,
            ReferenceRange = stool.ReferenceRange,
            ResultValue = stool.ResultValue,
        }));

        stoolCultures.ForEach(stoolCulture => finalLabCommands.Add(new FinalLabCommand()
        {
            ClassCode = CClass.StoolCulture,
            Interpretation = string.Empty,
            Name = stoolCulture.ResultItemName,
            ReferenceRange = stoolCulture.ReferenceRange,
            ResultValue = stoolCulture.ResultValue,
        }));

        specialTests.ForEach(specislTest => finalLabCommands.Add(new FinalLabCommand()
        {
            ClassCode = CClass.SpecialTest,
            Interpretation = string.Empty,
            Name = specislTest.ResultItemName,
            ReferenceRange = specislTest.ReferenceRange,
            ResultValue = specislTest.ResultValue,
        }));

        confidentials.ForEach(confidential => finalLabCommands.Add(new FinalLabCommand()
        {
            ClassCode = CClass.SpecialTest,
            Interpretation = string.Empty,
            Name = confidential.ResultItemName,
            ReferenceRange = confidential.ReferenceRange,
            ResultValue = confidential.ResultValue,
        }));

        bloodChemistry.ForEach(bloodChem => finalLabCommands.Add(new FinalLabCommand()
        {
            ClassCode = CClass.SpecialTest,
            Interpretation = string.Empty,
            Name = bloodChem.ResultItemName,
            ReferenceRange = bloodChem.ReferenceRange,
            ResultValue = bloodChem.ResultValue,
        }));
        //
        //Vision
        //
        var finalVisionCommand = new FinalVisionCommand()
        {
            ColorBlind = _hosXpEyeLabViewmodel.ColorBlind,
            VisualField = _hosXpEyeLabViewmodel.VisualField,
            Vision3D = _hosXpEyeLabViewmodel.Vision3D,
            VA_Right_Note = _hosXpEyeLabViewmodel.VA_Right_Note,
            VA_Left_Note = _hosXpEyeLabViewmodel.VA_Left_Note,
            PH_Left_Note = _hosXpEyeLabViewmodel.PH_Left_Note,
            PH_Right_Note = _hosXpEyeLabViewmodel.PH_Right_Note,
            PressureLeft = _hosXpEyeLabViewmodel.PressureLeft?.ToString(),
            PressureRight = _hosXpEyeLabViewmodel.PressureRight?.ToString(),
            RetinaLeft = _hosXpEyeLabViewmodel.RetinaLeft?.ToString(),
            RetinaRight = _hosXpEyeLabViewmodel.RetinaRight?.ToString(),
            Squint = _hosXpEyeLabViewmodel.Squint,
        };
        //
        //
        //
        var finalCommand = new SaveCheckupFinalReportCommand()
        {
            Id = _checkupViewModel.Id,
            FinalReports = new()
            {
                Labs = finalLabCommands,
                Vision = finalVisionCommand
            },
        };

        //_checkupApiClient.SaveFinalCheckupAsync(_checkupViewModel.Id, finalCommand);

    }


    private void gridViewCBC_CustomDrawCell(object sender, DevExpress.XtraGrid.Views.Base.RowCellCustomDrawEventArgs e)
    {
        if (e.RowHandle >= 0 && e.Column == gridViewCBC.Columns[1])
        {
            var value = gridViewCBC.GetRowCellValue(e.RowHandle, gridViewCBC.Columns[4]);
            if (value != null && value.ToString().Trim() == "Y")
            {
                e.Appearance.ForeColor = System.Drawing.ColorTranslator.FromHtml("#cc0000");
            }
